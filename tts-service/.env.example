TYPECAST_API_KEY=your-typecast-api-key

# 오디오 저장소: local(기본, static/audio 디스크) | ncp(네이버클라우드 금융 Object Storage)
# | db(Object Storage 장애 시 임시 대안, Postgres audio_binaries 테이블에 저장)
AUDIO_BACKEND=local

# AUDIO_BACKEND=ncp일 때만 필요
# https://guide-fin.ncloud-docs.com/docs/storage-storage-8-2
# AUDIO_NCP_ENDPOINT_URL=https://kr.object.fin-ncloudstorage.com
# AUDIO_NCP_REGION=fin-standard
# AUDIO_NCP_ACCESS_KEY=
# AUDIO_NCP_SECRET_KEY=
# AUDIO_NCP_BUCKET=
# AUDIO_CDN_BASE_URL=https://cdn.example.com

# AUDIO_BACKEND=db일 때만 필요. 백엔드(Spring Boot)가 같은 테이블을 읽으므로
# 반드시 그쪽과 동일한 Postgres를 가리켜야 한다.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/kom_cast
